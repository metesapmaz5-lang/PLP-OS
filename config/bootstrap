k#!/bin/sh

# ==========================================================
# PLP OS 2.0 "Ellie" Bootstrap Configuration
# Debian 12 Bookworm
# ==========================================================

# Architecture
LB_ARCHITECTURE="amd64"

# Debian release
LB_DISTRIBUTION="bookworm"
LB_PARENT_DISTRIBUTION="bookworm"

# Mirrors
LB_MIRROR_BOOTSTRAP="http://deb.debian.org/debian/"
LB_MIRROR_CHROOT="http://deb.debian.org/debian/"
LB_MIRROR_BINARY="http://deb.debian.org/debian/"

# Security repository (FIXED)
LB_MIRROR_CHROOT_SECURITY="http://deb.debian.org/debian-security/"
LB_MIRROR_BINARY_SECURITY="http://deb.debian.org/debian-security/"
LB_SECURITY_SUITE="bookworm-security"

# Updates repository
LB_MIRROR_CHROOT_UPDATES="http://deb.debian.org/debian/"
LB_MIRROR_BINARY_UPDATES="http://deb.debian.org/debian/"
LB_UPDATES_SUITE="bookworm-updates"

# Installer
LB_DEBIAN_INSTALLER="live"
LB_PARENT_DEBIAN_INSTALLER_DISTRIBUTION="bookworm"

# Image type
LB_BINARY_IMAGES="iso-hybrid"

# Archive areas
LB_ARCHIVE_AREAS="main contrib non-free non-free-firmware"

# Compression
LB_CHROOT_FILESYSTEM="squashfs"
LB_COMPRESSION="xz"

# Boot options
LB_BOOTAPPEND_LIVE="boot=live components quiet splash"
